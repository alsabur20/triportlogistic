# Database (PostgreSQL / Supabase)
DATABASE_URI="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require"

# Payload Secret (Generate via `openssl rand -base64 32`)
PAYLOAD_SECRET="your-super-secret-key-at-least-32-chars-long"

# Email Notifications (Optional - Nodemailer)
EMAIL_USER="info@triportlogistic.com"
EMAIL_PASS="your-email-password"

# Cloudflare R2 Storage (Optional - falls back to local public/media/ if omitted)
# 1. Create a bucket in Cloudflare R2 (e.g. "triport-media")
# 2. In Cloudflare R2 -> "Manage R2 API Tokens", create an API Token with Edit permissions
# 3. Fill in the values below:
R2_BUCKET="triport-media"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://<your-cloudflare-account-id>.r2.cloudflarestorage.com"
# Optional: If you connect a custom domain (e.g. media.triportlogistic.com) or enable R2 Public Development URL:
R2_PUBLIC_URL="https://media.triportlogistic.com"
